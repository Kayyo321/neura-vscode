{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Neura Virtual Assembly",
  "scopeName": "source.nvra",
  "fileTypes": [
    "nvra"
  ],
  "patterns": [
    {
      "name": "comment.line.semicolon.nvra",
      "match": ";.*$"
    },
    {
      "match": "\\b(bytes)\\s+([0-9a-fA-F]+)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.nvra"
        },
        "2": {
          "name": "constant.numeric.hex.nvra"
        }
      }
    },
    {
      "name": "entity.name.function.nvra",
      "match": "(?<![\\w-])(?:transferable-layouts|allocate-collection|region-collection|repeat-collection|allocate-object|write-component|append-element|construct-text|move-to-region|read-component|release-region|remove-element|text-from-utf8|native-library|region-object|region-repeat|write-element|native-symbol|enter-region|message-trap|read-element|read-version|write-global|concat-text|free-object|read-global|read-length|scalar-text|write-field|class-cast|class-hash|class-text|hook-enter|hook-leave|read-field|text-equal|text-slice|source-map|class-is|read-tag)(?![\\w-])"
    },
    {
      "name": "string.quoted.double.nvra",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nvra",
          "match": "\\\\(?:x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    {
      "name": "keyword.control.nvra",
      "match": "\\b(?:nvr|profile|entry|type|constant|graph|node|import|function|block|exit|layout|field|global|source|name|section|hint|transferable|version)\\b"
    },
    {
      "name": "storage.modifier.nvra",
      "match": "\\b(?:inputs|outputs|parameters|success|error|result|frame|selector|arguments|assign|resume|error-resume|reason|bytes|signed|unsigned|float|text|array|void|reference|object|fields|offset|length|align|slot|location|state|immediate|lanes|target|parent|interfaces|initializer|kernel|more|aggregate|activation|bias|edge|column|line|path|poll|record|width|callback|value|construct|list|bool|bfloat)\\b"
    },
    {
      "name": "entity.name.function.nvra",
      "match": "\\b(?:host|call|tail-call|return|continue|branch|trap|allocate|load|store|spawn|scope|scheduler|join|select|task_scope|scheduler_call)\\b"
    },
    {
      "name": "support.function.nvra",
      "match": "\\b(?:identity|relu|step|threshold|linear|constant|add|multiply|maximum|minimum)\\b"
    },
    {
      "name": "variable.other.property.nvra",
      "match": "\\b(?:constant|frame|global|argument):\\d+(?::\\d+)?\\b"
    },
    {
      "name": "constant.numeric.nvra",
      "match": "(?<!\\w)-?(?:\\d+\\.\\d*|\\d+)(?:[eE][+-]?\\d+)?\\b"
    },
    {
      "name": "punctuation.nvra",
      "match": "[\\[\\]{}(),:]"
    },
    {
      "name": "keyword.operator.nvra",
      "match": "->|=>|="
    }
  ]
}
