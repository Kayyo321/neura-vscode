{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NeuraIR Listing",
  "scopeName": "source.neurair",
  "patterns": [
    {
      "name": "comment.line.double-slash.neurair",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.neurair",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.neurair",
          "match": "\\\\(?:x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    {
      "name": "entity.name.function.neurair",
      "match": "%\\d+"
    },
    {
      "name": "entity.name.type.neurair",
      "match": "#\\d+"
    },
    {
      "name": "keyword.control.neurair",
      "match": "\\b(?:initialize|store|load|reference|receiver|field|index|collection|repeat_collection|reference_place|integer|float|string|boolean|unary|binary|short_circuit|call|virtual_call|external_call|base_initialize|allocate|length|append|remove_at|return|block|branch|loop|break|continue|destroy|discard|convert|collection_version|fail|tuple|project|enum_construct|enum_tag|enum_project|comparison_chain|scoped_value|select_value|make_closure|call_closure|nil|class_hash|class_text|class_is|class_cast|value_equals|value_hash|value_text|text_length|text_byte_at|text_slice|text_from_utf8|text_equal|reinterpret_float|trap_message|task_scope|spawn|scheduler_call)\\b"
    },
    {
      "name": "storage.type.neurair",
      "match": "\\b(?:file|module|class|alias|import|function|parameter|local|global|type_parameter|enum|variant|interface|symbol|symbols|type|attributes|export|mutable|const|static|override|abstract|at|frame|parameters|result)\\b"
    },
    {
      "name": "support.type.primitive.neurair",
      "match": "\\b(?:void|bool|string|u?int(?:8|16|32|64)?|byte|float(?:16|32|64)?|bfloat16|array|list|object|callable|tuple)\\b"
    },
    {
      "name": "constant.language.neurair",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "constant.numeric.neurair",
      "match": "(?<!\\w)-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[iu]?\\b"
    },
    {
      "name": "keyword.operator.neurair",
      "match": "->|=>|[=+*/%&|<>!-]+"
    },
    {
      "name": "punctuation.neurair",
      "match": "[{}\\[\\](),.:;]"
    }
  ]
}
