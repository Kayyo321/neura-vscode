{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022"],
    "moduleResolution": "node", "strict": true, "esModuleInterop": true,
    "outDir": "out", "rootDir": "src", "sourceMap": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
