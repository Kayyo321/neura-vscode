{
  "Application entry": {
    "prefix": [
      "nra-main",
      "main"
    ],
    "description": "Complete program using Std.Program.Entry.",
    "body": [
      "let console = import:Std.Io.Console;",
      "let program = import:Std.Program;",
      "",
      "let ${1:App} = module:program.Entry (",
      "    export let.override main = func(args: string[]) -> program.ExitCode {",
      "        console.print_line(\"${2:Hello, Neura!}\");",
      "        $0",
      "        return program.ExitCode.Ok;",
      "    };",
      ");"
    ]
  },
